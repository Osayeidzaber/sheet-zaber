# TEMPLATE ONLY — every value below stays empty on purpose.
# `security.md` "Secrets" keeps this file placeholder-only because it is committed: a real
# credential pasted here is in git history the next time anyone stages it. Put actual values in
# `.env.local` (ignored by `.gitignore`), which is also the file Next.js actually loads —
# nothing in this repository reads `.env.example`.

# --- Database ---
# Supabase offers two endpoints: the POOLED one (host `db.<project>.supabase.co`, port 6543,
# add `?sslmode=require`) for serverless, and the DIRECT one (same host, port 5432, database
# `postgres`) for a long-lived server. Either works locally; the pooled one is the right default
# on Vercel, where direct connections exhaust the pool.
# No Supabase? `pnpm db:local` boots an embedded Postgres 16 on port 5433 (data in `.pg-local/`,
# database `sheet_zaber`) and prints the URL to paste into `.env.local`, e.g.:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sheet_zaber
DATABASE_URL=

# --- Secrets ---
# `pnpm make-keys` generates both and writes them to `.env.local`, filling only the lines that
# are still empty. Rotate deliberately: a new SESSION_SECRET logs every user out, and a new
# TOKEN_ENCRYPTION_KEY makes the stored Google refresh tokens unreadable.
# SESSION_SECRET: HMAC key for session cookies (>= 32 chars)
SESSION_SECRET=
# TOKEN_ENCRYPTION_KEY: base64-encoded 32-byte key for AES-256-GCM token encryption
TOKEN_ENCRYPTION_KEY=

# --- Owner bootstrap ---
# First verified Google login with this email receives role=owner
OWNER_EMAIL=

# --- Google OAuth ---
# Optional in dev (login screen shows "Google OAuth not configured"); mandatory in production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Public ---
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Server ---
# Retention window (days) for api_request_logs before pruning (default 90)
LOG_RETENTION_DAYS=90

# --- Outbound email (Resend) ---
# Only `inviteUsers` (POST /api/internal/admin/invitations with `emails`) uses these. With either
# unset, invitation codes still mint normally; invite-by-email fails with a typed error
# (`email_not_configured` / `email_from_missing`) and mints nothing.
# RESEND_API_KEY: create at https://resend.com/api-keys — the real value belongs ONLY in `.env.local`
RESEND_API_KEY=
# RESEND_FROM_EMAIL: a sender address on a domain you verified in the Resend dashboard
# (e.g. invites@yourdomain.example). No default on purpose — an unverified sender is a
# failure, never a guess.
RESEND_FROM_EMAIL=

# PEM of the database CA (literal \n allowed). Required for Supabase: the connection verifies TLS.
DATABASE_CA_CERT=

# Header holding the real client IP behind your host; empty uses x-forwarded-for. See docs/deployment-render.md.
CLIENT_IP_HEADER=
